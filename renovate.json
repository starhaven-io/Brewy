{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>starhaven-io/.github:renovate-config#v2026.10.22.2"],
  "ignorePresets": ["mergeConfidence:all-badges"],
  "packageRules": [
    {
      "description": "The companion managers own this runtime as one dependency.",
      "matchManagers": ["ruby-version"],
      "matchFileNames": [".ruby-version"],
      "enabled": false
    },
    {
      "matchDatasources": ["custom.ruby-builder-ubuntu"],
      "matchFileNames": [".ruby-version","Gemfile.lock"],
      "enabled": true,
      "groupName": "Ruby runtime",
      "groupSlug": "ruby-runtime",
      "group": { "branchTopic": "ruby-{{{newMajor}}}.x" }
    },
    {
      "description": "A replaced same-version archive requires investigation.",
      "matchDatasources": ["custom.ruby-builder-ubuntu"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ]
}
